  "id": "iron-cross",
  "funName": "Iron Cross",
  "plainName": "Stops and starts to the dot and the edges of a circle",
  "sourceTitle": "Iron cross",
  "minutes": 10,
  "gear": "Pucks for Level 2",
  "worksAsStation": true,
  "description": "Use both end-zone circles, one group at each. Each group lines up at the bottom of its circle, by the goal line. One skater at a time skates to the face-off dot and stops, then goes out to an edge of the circle and back to the dot three times: the edge by the boards, the top of the circle, and the inside edge. A hard stop at every point. Then skate back to the bottom and the next skater goes.",
  "steps": [
    "Skate to the dot and stop.",
    "Out to the edge by the boards, stop, and back to the dot.",
    "Out to the top of the circle, stop, and back to the dot.",
    "Out to the inside edge, stop, and back to the dot.",
    "Skate back to the bottom. The next skater goes."
  ],
  "cues": [
    "Stop on the dot!",
    "Make snow at every stop.",
    "Push hard out of every stop."
  ],
