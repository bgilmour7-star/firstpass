{
  "id": "u11-up-the-wall",
  "funName": "Up the Wall",
  "plainName": "Basic breakout: defender, winger, centre, up ice",
  "sourceTitle": "Breakout introduction; Breakout x4 (up, wheel, over)",
  "minutes": 10,
  "gear": "Pucks",
  "worksAsStation": false,
  "description": "Five skaters in their breakout spots: two defenders, a winger on each wall at the hash marks and a centre low in the slot. The coach dumps the puck into a corner. One defender gets it while the centre swings low to that side. The defender passes up the wall to the winger, the winger passes to the centre, and all three forwards skate up ice in their lanes. Go to both sides and rotate everyone through every spot.",
  "steps": [
    "The coach dumps the puck into the corner.",
    "One defender gets the puck; the centre swings low to that side.",
    "Pass up the wall to the winger.",
    "Winger to the centre, and all three skate up ice."
  ],
  "cues": [
    "Shoulder check, then get to the puck.",
    "Winger: call for it, stick on the ice.",
    "Centre: swing low, support."
  ],
