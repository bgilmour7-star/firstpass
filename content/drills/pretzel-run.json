{
  "id": "pretzel-run",
  "funName": "Pretzel Run",
  "plainName": "Figure 8 around the circles, then a pass and a shot",
  "sourceTitle": "Trace the circles",
  "minutes": 8,
  "gear": "Pucks, 1 cone",
  "worksAsStation": false,
  "description": "Put a cone on the face-off dot just outside the blue line. Skaters line up in the corner. One at a time, skate around the outside of the first face-off circle one and a half times, cut across the slot and go around the second circle one and a half times the other way, like a figure 8. Keep going down the far boards past the blue line and around the cone. The coach passes you a puck; skate in through the slot and shoot. The next skater goes when the one ahead reaches the second circle, so skaters cross in the slot.",
  "steps": [
    "Out of the corner and around the first circle one and a half times.",
    "Cut across the slot and around the second circle one and a half times.",
    "Down the far boards and around the cone on the face-off dot.",
    "Take a pass from the coach, skate in and shoot."
  ],
  "cues": [
    "Head up in the middle!",
    "Stick on the ice for the pass.",
    "Lean into the turns."
  ],
