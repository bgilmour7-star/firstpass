    "Skate forward past the first cone.",
    "Pivot to backward at the halfway mark, eyes on the next cone.",
    "Pivot to forward at the cone, and keep going to the end."
  ],
  "cues": [
    "Eyes on the next cone.",
    "Stick leads the turn."
  ],
